{
  "manifest_version": 3,
  "name": "Fading Furigana",
  "version": "0.1.0",
  "description": "Annotates unknown Japanese kanji words with furigana and lets users save or hide words.",
  "icons": {
    "16": "src/icons/icon-16.png",
    "32": "src/icons/icon-32.png",
    "48": "src/icons/icon-48.png",
    "128": "src/icons/icon-128.png",
    "256": "src/icons/icon-256.png",
    "512": "src/icons/icon-512.png",
    "1024": "src/icons/icon-1024.png"
  },
  "permissions": ["storage", "unlimitedStorage", "activeTab", "nativeMessaging"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/core/appState.js",
        "src/core/annotationDecision.js",
        "src/core/pageLanguage.js",
        "src/core/readingEvidence.js",
        "src/storage/localStorageAdapter.js",
        "src/storage/recordBatchCodec.js",
        "src/storage/safariNativeStorageAdapter.js",
        "src/storage/chromeLoopbackClient.js",
        "src/storage/chromeStorageAdapter.js",
        "src/storage/persistScheduler.js",
        "src/repositories/repositories.js",
        "src/services/wordRepositoryService.js",
        "src/dictionary/data/jmdictCommonData.js",
        "src/dictionary/localDictionaryProvider.js",
        "src/dictionary/backgroundTokenizerClient.js",
        "src/content/tooltip.js",
        "src/content/annotationEngine.js",
        "src/content/contentScript.js"
      ],
      "css": ["src/styles/annotation.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Fading Furigana",
    "default_popup": "src/popup/popup.html"
  }
}
